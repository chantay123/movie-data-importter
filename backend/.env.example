# Port the importer API listens on.
IMPORT_API_PORT=4100

# Maximum number of TXT files processed concurrently.
IMPORT_MAX_CONCURRENCY=3

# Maximum size accepted for a single TXT file, in bytes (10 MB).
IMPORT_MAX_FILE_SIZE=10485760

# Comma separated list of origins allowed to call the importer API.
IMPORT_CORS_ORIGINS=http://localhost:4173,http://localhost:3000,http://localhost:5000

# Shared secret used by the admin panel to authenticate against the importer API.
# When empty, the API only accepts an admin JWT bearer token.
IMPORT_ADMIN_API_KEY=change-me

# Path of the crawler project, used to reuse its MongoDB credentials and its Movie model.
CRAWLER_PROJECT_PATH=../crawl-data-movie

# MongoDB connection string and database name.
# When empty, the values of the crawler `.env` file are reused.
MONGODB_URI=
MONGODB_NAME=
